<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-add-owner-status-type-timestamps" author="cards">
        <!-- columns may already exist if the DB was migrated earlier by flyway -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="cards" columnName="owner_id"/>
            </not>
        </preConditions>

        <addColumn tableName="cards">
            <column name="owner_id" type="UUID"/>
            <column name="status" type="VARCHAR(10)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(10)" defaultValue="DEBIT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- existing cards have no owner yet: give each a placeholder owner so NOT NULL can be applied -->
        <sql>UPDATE cards SET owner_id = gen_random_uuid() WHERE owner_id IS NULL</sql>

        <addNotNullConstraint tableName="cards" columnName="owner_id" columnDataType="UUID"/>

        <createIndex tableName="cards" indexName="idx_cards_owner_id">
            <column name="owner_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
